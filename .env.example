# ---------------------------------------------------------------------------
# RaceStream configuration. Copy to `.env` and edit; `.env` is gitignored.
# Every value here has a working default for `docker compose up`.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
POSTGRES_USER=racestream
POSTGRES_PASSWORD=racestream
POSTGRES_DB=racestream
# Services inside the compose network reach the database by service name.
DB_DSN=postgresql://racestream:racestream@timescaledb:5432/racestream
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_WRITE_BATCH_SIZE=500
DB_WRITE_BATCH_TIMEOUT_S=0.5

# --- Kafka / Redpanda -----------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
KAFKA_CLIENT_ID=racestream
KAFKA_ACKS=all
KAFKA_LINGER_MS=10
KAFKA_COMPRESSION_TYPE=lz4
KAFKA_MAX_POLL_RECORDS=500
KAFKA_AUTO_OFFSET_RESET=earliest

# --- Observability --------------------------------------------------------
OBS_LOG_LEVEL=INFO
OBS_LOG_JSON=true
OBS_ENVIRONMENT=local

# --- Upstream data source -------------------------------------------------
# OpenF1 is a free, public, unauthenticated F1 timing API. No key required.
OPENF1_BASE_URL=https://api.openf1.org/v1
OPENF1_TIMEOUT_S=30
OPENF1_MAX_RETRIES=4
OPENF1_MAX_CONCURRENT_REQUESTS=4

# --- API ------------------------------------------------------------------
API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
API_RATE_LIMIT_PER_MINUTE=120

# --- Frontend (build-time; Vite only exposes VITE_* to the browser) -------
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/live
